# Club crests, cached from Wikipedia by `npm run fetch:badges`.
# ~95 MB of PNGs and reproducible, so the URLs live in data/clubs.json instead
# and the app falls back to them when the cache is absent.
public/badges/

# Production builds made alongside a running dev server. See next.config.ts.
.next-prod/

# Seeded design-canvas payloads. ~3 MB each and almost entirely the canvas
# editor's own minified code. The SOURCE is committed — the .dc.html artboards,
# design/sheets/ and canvas.json — and `npm run build:sheets` regenerates it.
recall-xi-graded-boards.html
design/recall-xi-design-strands.html
